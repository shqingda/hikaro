{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hikaro-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": { "PUBLIC_REGISTRATION": "true" },
  "durable_objects": {
    "bindings": [
      { "name": "HOSTS", "class_name": "HostRelay" },
      { "name": "PAIRINGS", "class_name": "PairingRegistry" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HostRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["PairingRegistry"] },
  ],
  "queues": {
    "producers": [
      { "binding": "NOTIFICATIONS", "queue": "hikaro-notifications" },
    ],
    "consumers": [{ "queue": "hikaro-notifications", "max_batch_size": 20 }],
  },
}
