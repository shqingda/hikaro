{
  "expo": {
    "name": "Hikaro",
    "slug": "hikaro",
    "scheme": "hikaro",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "../../brand/hikaro-icon.png",
    "ios": { "supportsTablet": true, "bundleIdentifier": "dev.hikaro.mobile" },
    "android": { "package": "dev.hikaro.mobile" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Scan a Hikaro pairing code from your computer." }
      ],
      "expo-notifications"
    ]
  }
}
