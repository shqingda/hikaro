{
  "expo": {
    "name": "hikaro",
    "slug": "hikaro-mobile",
    "scheme": "hikaro-companion",
    "version": "0.3.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.hikaro.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "连接同一 Wi-Fi 上的 Hikaro 电脑。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.hikaro.mobile",
      "versionCode": 1,
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "用相机扫描你电脑上的 Hikaro 配对码。",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      "./scripts/with-lan.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
