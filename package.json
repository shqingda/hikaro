{
  "name": "hikaro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "tsx apps/cli/src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/hikaro.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "check:install": "node scripts/check-install.mjs",
    "check:upgrade": "node scripts/check-upgrade.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:check": "node scripts/bench.mjs --check",
    "bench:attach:check": "node scripts/bench-shared-host.mjs --check",
    "bench:soak": "node scripts/bench-soak.mjs",
    "bench:soak:check": "node scripts/bench-soak.mjs --check",
    "bench:harness": "node --import tsx scripts/bench-harness.mjs",
    "bench:harness:check": "node --import tsx scripts/bench-harness.mjs --check",
    "postinstall": "node scripts/prepare-native.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:pi": "pnpm build && node scripts/pi-smoke.mjs",
    "check:relay": "pnpm --filter @hikaro/relay typecheck",
    "dev:mobile": "pnpm --filter @hikaro/mobile start",
    "dev:sim": "node scripts/dev-sim.mjs",
    "mobile:lab:check": "vitest run tests/mobile-lab.test.ts tests/dev-sim.test.ts",
    "mobile:ios": "pnpm --filter @hikaro/mobile ios",
    "mobile:android": "pnpm --filter @hikaro/mobile android",
    "mobile:typecheck": "pnpm --filter @hikaro/mobile typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.1",
    "ajv": "8.20.0",
    "node-pty": "1.1.0",
    "playwright": "1.64.0",
    "qrcode-terminal": "0.12.0",
    "quickjs-emscripten": "0.32.0",
    "tweetnacl": "1.0.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode-terminal": "0.12.2",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "serve-sim": "0.1.48",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
